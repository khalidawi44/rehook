# Copier ce fichier en .env et remplir ce qui est utile.

# Port de l'API (l'interface Vite tourne sur 5173 en dev et proxifie /api).
PORT=3001

# Clé API Anthropic : obligatoire pour « Recréer cette vidéo » (le script).
ANTHROPIC_API_KEY=
# Si la clé est une clé d'organisation (erreur « not scoped to a workspace »), l'identifiant du
# workspace (Console → Settings → Workspaces, commence par wrkspc_). Inutile avec une clé créée dans un workspace.
ANTHROPIC_WORKSPACE_ID=
# Modèle utilisé pour écrire la variante (défaut : claude-opus-5-5).
NICHE_MODEL=claude-opus-5-5

# Découverte des vidéos virales (hashtags, mots-clés, comptes).
#   browser : Chromium local (Playwright), gratuit, fragile si TikTok bloque.
#   apify   : acteur clockworks/tiktok-scraper (payant, robuste). Demande APIFY_TOKEN.
#   none    : seulement l'import manuel d'URL et le rafraîchissement des stats.
NICHE_DISCOVERY=browser
APIFY_TOKEN=
# Chemin d'un Chromium déjà installé (sinon « npx playwright install chromium »).
PLAYWRIGHT_EXECUTABLE=

# Visuels des scènes : stock-video (clips vidéo libres de droits, recommandé), pexels (photos libres),
# openai (images générées), none (fonds typographiques).
# Clé Pixabay gratuite et immédiate : https://pixabay.com/api/docs/ (connecté, la clé est affichée dans la page).
# Clé Pexels (https://www.pexels.com/api/) si la création de clés est rouverte.
NICHE_IMAGES=stock-video
PIXABAY_API_KEY=
PEXELS_API_KEY=
OPENAI_API_KEY=

# Voix off : none, edge (gratuit, sans clé), openai, elevenlabs, piper (binaire local).
NICHE_VOICE=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PIPER_BIN=piper
PIPER_MODEL=

# Rendu Remotion : chemin d'un Chrome headless shell si on ne veut pas le téléchargement automatique.
REMOTION_BROWSER_EXECUTABLE=

# Intervalle de rafraîchissement automatique des stats, en minutes (0 = jamais).
NICHE_REFRESH_MINUTES=120

# Veille : découverte toutes les N minutes, relevé des compteurs toutes les N minutes.
NICHE_DISCOVERY_MINUTES=15
NICHE_WATCH_MINUTES=2

# Alertes « ça explose » envoyées aussi sur Telegram (bot créé via @BotFather, chat_id de ta conversation avec lui).
NICHE_TELEGRAM_BOT_TOKEN=
NICHE_TELEGRAM_CHAT_ID=

# Pack chargé automatiquement au premier lancement (humour-fr) ; vide = données de démonstration.
NICHE_PACK=humour-fr

# Accès sur Internet (serveur cloud) : mot de passe demandé à l'ouverture. Vide = pas de mot de passe (usage local).
NICHE_PASSWORD=
# Nom de domaine du serveur (certificat HTTPS automatique via Caddy, voir deploy/). Vide = HTTP sur l'IP.
NICHE_DOMAIN=

# Publication en un clic via Postiz (postiz.com ou auto-hébergé) : TikTok, Instagram, YouTube, X, Facebook, Threads…
# Clé dans Postiz → Settings → Public API. POSTIZ_API_URL seulement si auto-hébergé.
POSTIZ_API_KEY=
POSTIZ_API_URL=
